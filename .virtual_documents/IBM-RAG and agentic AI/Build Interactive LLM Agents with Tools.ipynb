from langchain_core.tools import tool
from langchain_core.messages import HumanMessage , ToolMessage,SystemMessage
import os


from langchain.chat_models import init_chat_model
api_key = "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"
llm = init_chat_model(model= "llama-3.3-70b-versatile", model_provider= "groq",api_key = api_key)


@tool
def add(a:int , b:int)->int:
    """
    Adds a and b
    Parameters:
    -a (int):The first integer to be added
    -b (int): The second integer to be added
    Returns:
    - int : The result of adding the 2 integers
    """
    return a+b


tools = [add]
llm_with_tools = llm.bind_tools(tools)


@tool
def subtract(a: int, b:int) -> int:
    """Subtract b from a."""
    return a - b

@tool
def multiply(a: int, b:int) -> int:
    """Multiply a and b."""
    return a * b


tool_map = {
    "add": add, 
    "subtract": subtract,
    "multiply": multiply
}

input_ = {
    "a": 1,
    "b": 2
}

tool_map["multiply"].invoke(input_)


tools = [add,subtract,multiply]
llm_with_tools = llm.bind_tools(tools)


query = "What is 5+3?."
chat_history = [SystemMessage(content= "You must only use the tools to get the answer"), HumanMessage(content= query)]


response_1 = llm_with_tools.invoke(chat_history)
chat_history.append(response_1)
print(response_1)


tool_calls_1 = response_1.tool_calls

tool_1_name = tool_calls_1[0]["name"]
tool_1_args = tool_calls_1[0]["args"]
tool_call_1_id = tool_calls_1[0]["id"]

print(f'tool name:\n{tool_1_name}')
print(f'tool args:\n{tool_1_args}')
print(f'tool call ID:\n{tool_call_1_id}')


print(response_1.tool_calls)



